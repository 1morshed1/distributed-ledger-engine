# Local dev config. Loaded by viper. Do NOT commit real secrets in later phases.
ENVIRONMENT=development
DB_SOURCE=postgresql://ledger:secret@localhost:5433/ledger?sslmode=disable
REDIS_ADDRESS=localhost:6380
HTTP_SERVER_ADDRESS=0.0.0.0:8080
GRPC_SERVER_ADDRESS=0.0.0.0:9090
# 32-byte symmetric key for PASETO v4.local, or key material for v4.public (set in auth step).
TOKEN_SYMMETRIC_KEY=12345678901234567890123456789012
ACCESS_TOKEN_DURATION=15m
REFRESH_TOKEN_DURATION=24h
